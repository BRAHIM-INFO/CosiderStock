@{
    ViewBag.Title = "Support & Contact";
    Layout = "_DashboardLayout";
}

@section styles {
    @await Html.PartialAsync("_SettingsStyles")
    <style>
        /* Hero Developer Card */
        .developer-hero {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            border-radius: 24px;
            padding: 45px 40px;
            color: #fff;
            position: relative;
            overflow: hidden;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 35px;
        }

            .developer-hero::before {
                content: '';
                position: absolute;
                width: 500px;
                height: 500px;
                background: radial-gradient(circle, rgba(200,16,46,0.25) 0%, transparent 70%);
                top: -200px;
                right: -100px;
            }

            .developer-hero::after {
                content: '';
                position: absolute;
                width: 300px;
                height: 300px;
                background: radial-gradient(circle, rgba(52,152,219,0.15) 0%, transparent 70%);
                bottom: -100px;
                left: -50px;
            }

        .developer-avatar {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: linear-gradient(135deg, #C8102E, #e63950);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 55px;
            font-weight: 800;
            color: #fff;
            position: relative;
            z-index: 1;
            box-shadow: 0 20px 50px rgba(200,16,46,0.4);
            border: 5px solid rgba(255,255,255,0.1);
            flex-shrink: 0;
            animation: avatarFloat 4s ease-in-out infinite;
        }

        @@keyframes avatarFloat {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        .developer-badge {
            position: absolute;
            bottom: 8px;
            right: 8px;
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #2ecc71, #27ae60);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            border: 4px solid #1a1a2e;
            color: #fff;
        }

        .developer-info {
            position: relative;
            z-index: 1;
            flex: 1;
        }

        .developer-tag {
            display: inline-block;
            background: rgba(200,16,46,0.2);
            border: 1px solid rgba(200,16,46,0.4);
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #ff6b7a;
            margin-bottom: 12px;
        }

        .developer-info h1 {
            font-size: 38px;
            font-weight: 800;
            margin: 0;
            letter-spacing: -1px;
            background: linear-gradient(135deg, #fff, #cbd5e1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .developer-title {
            font-size: 16px;
            color: rgba(255,255,255,0.7);
            margin-top: 6px;
            font-weight: 500;
            letter-spacing: 1px;
        }

        .developer-skills {
            display: flex;
            gap: 8px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .skill-tag {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            color: rgba(255,255,255,0.8);
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .skill-tag i {
                color: #C8102E;
                font-size: 10px;
            }

        /* Contact Cards */
        .contacts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .contact-card {
            background: #fff;
            border-radius: 18px;
            padding: 25px;
            border: 2px solid #f0f0f0;
            transition: all 0.4s;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

            .contact-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(90deg, transparent, transparent);
                transition: all 0.4s;
            }

            .contact-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            }

            .contact-card.whatsapp:hover {
                border-color: #25D366;
            }

                .contact-card.whatsapp:hover::before {
                    background: linear-gradient(90deg, #25D366, #128C7E);
                }

            .contact-card.email:hover {
                border-color: #EA4335;
            }

                .contact-card.email:hover::before {
                    background: linear-gradient(90deg, #EA4335, #FBBC05);
                }

            .contact-card.phone:hover {
                border-color: #3498db;
            }

                .contact-card.phone:hover::before {
                    background: linear-gradient(90deg, #3498db, #2980b9);
                }

        .contact-icon {
            width: 65px;
            height: 65px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: #fff;
            margin-bottom: 15px;
            transition: all 0.4s;
        }

        .contact-card.whatsapp .contact-icon {
            background: linear-gradient(135deg, #25D366, #128C7E);
            box-shadow: 0 10px 25px rgba(37,211,102,0.3);
        }

        .contact-card.email .contact-icon {
            background: linear-gradient(135deg, #EA4335, #FBBC05);
            box-shadow: 0 10px 25px rgba(234,67,53,0.3);
        }

        .contact-card.phone .contact-icon {
            background: linear-gradient(135deg, #3498db, #2980b9);
            box-shadow: 0 10px 25px rgba(52,152,219,0.3);
        }

        .contact-card:hover .contact-icon {
            transform: scale(1.1) rotate(-5deg);
        }

        .contact-card h3 {
            font-size: 16px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0 0 5px 0;
        }

        .contact-card .label {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 15px;
        }

        .contact-card .value {
            font-size: 15px;
            font-weight: 600;
            color: #333;
            margin-bottom: 18px;
            direction: ltr;
            text-align: left;
        }

        .contact-btn {
            width: 100%;
            padding: 11px;
            border: none;
            border-radius: 12px;
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s;
            color: #fff;
        }

            .contact-btn.whatsapp {
                background: linear-gradient(135deg, #25D366, #128C7E);
            }

            .contact-btn.email {
                background: linear-gradient(135deg, #EA4335, #FBBC05);
            }

            .contact-btn.phone {
                background: linear-gradient(135deg, #3498db, #2980b9);
            }

            .contact-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            }

        /* FAQ / Info Section */
        .support-section {
            background: linear-gradient(135deg, #fafbfc, #fff);
            border-radius: 18px;
            padding: 28px 30px;
            border: 1px solid #f1f5f9;
        }

            .support-section h2 {
                font-size: 18px;
                font-weight: 700;
                color: #1a1a2e;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 12px;
            }

                .support-section h2 i {
                    width: 40px;
                    height: 40px;
                    background: linear-gradient(135deg, #C8102E, #e63950);
                    color: #fff;
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 16px;
                }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
        }

        .info-item {
            background: #fff;
            padding: 18px;
            border-radius: 12px;
            border: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: all 0.3s;
        }

            .info-item:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.05);
                border-color: #C8102E;
            }

        .info-item-icon {
            width: 40px;
            height: 40px;
            background: rgba(200,16,46,0.1);
            color: #C8102E;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .info-item .label {
            font-size: 10px;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .info-item .value {
            font-size: 13px;
            color: #333;
            font-weight: 600;
            margin-top: 2px;
        }

        @@media (max-width: 768px) {
            .developer-hero {
                flex-direction: column;
                text-align: center;
                padding: 35px 25px;
            }

            .developer-info h1 {
                font-size: 28px;
            }

            .developer-skills {
                justify-content: center;
            }
        }
    </style>
}

