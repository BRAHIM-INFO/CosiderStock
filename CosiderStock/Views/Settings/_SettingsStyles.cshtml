<style>
    /* ==================== LAYOUT PRINCIPAL ==================== */
    .settings-container {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 25px;
        margin-top: -10px;
    }

    /* ==================== SIDEBAR SETTINGS ==================== */
    .settings-sidebar {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 25px rgba(0,0,0,0.06);
        height: fit-content;
        position: sticky;
        top: 90px;
        border: 1px solid rgba(0,0,0,0.03);
    }

    .settings-sidebar-header {
        background: linear-gradient(135deg, #C8102E, #e63950);
        padding: 25px 22px;
        display: flex;
        align-items: center;
        gap: 15px;
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .settings-sidebar-header::before {
            content: '';
            position: absolute;
            width: 150px;
            height: 150px;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
            top: -50px;
            right: -30px;
        }

    .settings-icon-main {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.2);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        backdrop-filter: blur(10px);
        position: relative;
        z-index: 1;
    }

    .settings-sidebar-header h3 {
        font-size: 18px;
        font-weight: 700;
        margin: 0;
        position: relative;
        z-index: 1;
    }

    .settings-sidebar-header p {
        font-size: 12px;
        opacity: 0.9;
        margin: 2px 0 0 0;
        position: relative;
        z-index: 1;
    }

    .settings-nav {
        list-style: none;
        padding: 15px 0;
        margin: 0;
    }

        .settings-nav li a {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 14px 22px;
            text-decoration: none;
            color: #475569;
            transition: all 0.25s;
            border-left: 4px solid transparent;
            position: relative;
        }

            .settings-nav li a:hover {
                background: linear-gradient(90deg, rgba(200,16,46,0.04), transparent);
                color: #C8102E;
            }

            .settings-nav li a.active {
                background: linear-gradient(90deg, rgba(200,16,46,0.08), transparent);
                border-left-color: #C8102E;
                color: #C8102E;
            }

    .nav-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        transition: all 0.25s;
    }

    .nav-icon-blue {
        background: rgba(52,152,219,0.12);
        color: #3498db;
    }

    .nav-icon-green {
        background: rgba(46,204,113,0.12);
        color: #2ecc71;
    }

    .nav-icon-orange {
        background: rgba(230,126,34,0.12);
        color: #e67e22;
    }

    .nav-icon-purple {
        background: rgba(155,89,182,0.12);
        color: #9b59b6;
    }

    .settings-nav li a.active .nav-icon {
        transform: scale(1.05);
    }

    .nav-content {
        flex: 1;
    }

    .nav-title {
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .nav-subtitle {
        font-size: 11px;
        color: #94a3b8;
    }

    .nav-arrow {
        font-size: 11px;
        color: #cbd5e1;
        transition: transform 0.25s;
    }

    .settings-nav li a:hover .nav-arrow,
    .settings-nav li a.active .nav-arrow {
        transform: translateX(3px);
        color: #C8102E;
    }

    .settings-sidebar-footer {
        padding: 15px 22px;
        border-top: 1px solid #f1f5f9;
        background: #fafbfc;
    }

    .version-info {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        color: #94a3b8;
        font-weight: 500;
    }

    /* ==================== CONTENT AREA ==================== */
    .settings-content {
        background: #fff;
        border-radius: 20px;
        padding: 30px 35px;
        box-shadow: 0 4px 25px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.03);
        min-height: 600px;
    }

    .content-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #f5f5f5;
    }

    .content-header-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .content-header-icon {
        width: 55px;
        height: 55px;
        background: linear-gradient(135deg, #C8102E, #e63950);
        color: #fff;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        box-shadow: 0 6px 20px rgba(200,16,46,0.25);
    }

    .content-header h1 {
        font-size: 22px;
        font-weight: 700;
        color: #1a1a2e;
        margin: 0;
    }

    .content-header p {
        font-size: 13px;
        color: #94a3b8;
        margin: 3px 0 0 0;
    }

    /* ==================== BUTTONS ==================== */
    .btn-action {
        padding: 11px 22px;
        border: none;
        border-radius: 12px;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
        white-space: nowrap;
        text-decoration: none;
    }

    .btn-primary-red {
        background: linear-gradient(135deg, #C8102E, #e63950);
        color: #fff;
        box-shadow: 0 6px 18px rgba(200,16,46,0.25);
    }

        .btn-primary-red:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(200,16,46,0.35);
        }

    .btn-secondary-gray {
        background: #f5f6fa;
        color: #555;
        border: 1px solid #e8e8e8;
    }

        .btn-secondary-gray:hover {
            background: #e8e8e8;
        }

    .btn-icon-only {
        width: 38px;
        height: 38px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.25s;
        font-size: 14px;
    }

    .btn-icon-blue {
        background: rgba(52,152,219,0.1);
        color: #3498db;
    }

        .btn-icon-blue:hover {
            background: #3498db;
            color: #fff;
        }

    .btn-icon-green {
        background: rgba(46,204,113,0.1);
        color: #2ecc71;
    }

        .btn-icon-green:hover {
            background: #2ecc71;
            color: #fff;
        }

    .btn-icon-orange {
        background: rgba(230,126,34,0.1);
        color: #e67e22;
    }

        .btn-icon-orange:hover {
            background: #e67e22;
            color: #fff;
        }

    .btn-icon-red {
        background: rgba(231,76,60,0.1);
        color: #e74c3c;
    }

        .btn-icon-red:hover {
            background: #e74c3c;
            color: #fff;
        }

    /* ==================== TOAST ==================== */
    .toast-container {
        position: fixed;
        top: 85px;
        right: 20px;
        z-index: 9999;
    }

    .toast {
        background: #fff;
        padding: 15px 20px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 300px;
        animation: toastSlide 0.4s;
        border-left: 4px solid #C8102E;
    }

        .toast.success {
            border-left-color: #2ecc71;
        }

        .toast.error {
            border-left-color: #e74c3c;
        }

        .toast.warning {
            border-left-color: #f39c12;
        }

        .toast i {
            font-size: 20px;
        }

        .toast.success i {
            color: #2ecc71;
        }

        .toast.error i {
            color: #e74c3c;
        }

        .toast.warning i {
            color: #f39c12;
        }

    .toast-content .toast-title {
        font-size: 13px;
        font-weight: 600;
        color: #333;
    }

    .toast-content .toast-message {
        font-size: 12px;
        color: #666;
        margin-top: 2px;
    }

    @@keyframes toastSlide {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    /* ==================== MODAL ==================== */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 9998;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(3px);
    }

        .modal-overlay.active {
            display: flex;
            animation: fadeIn 0.3s;
        }

    .modal-content {
        background: #fff;
        border-radius: 20px;
        padding: 0;
        width: 90%;
        max-width: 550px;
        max-height: 90vh;
        overflow-y: auto;
        animation: modalSlide 0.3s;
    }

    @@keyframes modalSlide {
        from {
            transform: translateY(-30px) scale(0.95);
            opacity: 0;
        }

        to {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .modal-header {
        background: linear-gradient(135deg, #C8102E, #e63950);
        color: #fff;
        padding: 22px 28px;
        display: flex;
        align-items: center;
        gap: 15px;
        border-radius: 20px 20px 0 0;
    }

    .modal-icon {
        width: 45px;
        height: 45px;
        background: rgba(255,255,255,0.2);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .modal-title {
        font-size: 17px;
        font-weight: 700;
    }

    .modal-subtitle {
        font-size: 12px;
        opacity: 0.9;
        margin-top: 2px;
    }

    .modal-close {
        margin-left: auto;
        background: rgba(255,255,255,0.15);
        border: none;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        color: #fff;
        cursor: pointer;
        transition: all 0.3s;
    }

        .modal-close:hover {
            background: rgba(255,255,255,0.3);
            transform: rotate(90deg);
        }

    .modal-body {
        padding: 28px;
    }

    .modal-footer {
        padding: 18px 28px;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        background: #fafbfc;
        border-radius: 0 0 20px 20px;
    }

    /* ==================== FORMS ==================== */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #555;
        margin-bottom: 8px;
        letter-spacing: 0.5px;
    }

        .form-label i {
            color: #C8102E;
            margin-right: 5px;
        }

    .form-input {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e8e8e8;
        border-radius: 10px;
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        background: #fafafa;
        transition: all 0.3s;
    }

        .form-input:focus {
            outline: none;
            border-color: #C8102E;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(200,16,46,0.08);
        }

    select.form-input {
        cursor: pointer;
    }

    /* Switch */
    .switch-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 26px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #ddd;
        transition: 0.4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 3px;
            bottom: 3px;
            background: #fff;
            transition: 0.4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background: linear-gradient(135deg, #2ecc71, #27ae60);
    }

        input:checked + .slider:before {
            transform: translateX(24px);
        }

    /* ==================== RESPONSIVE ==================== */
    @@media (max-width: 992px) {
        .settings-container {
            grid-template-columns: 1fr;
        }

        .settings-sidebar {
            position: static;
        }

        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>