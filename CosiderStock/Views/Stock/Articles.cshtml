@section scripts {
    <script>
        // ==================== ÉTAT ====================
        var currentSort = { by: '', dir: 'asc' };
        var currentPage = 1;
        var currentData = [];
        var selectedIds = new Set(); // Sélection persistante entre pages
        var debounceTimer;

        // ==================== DEBOUNCE POUR RECHERCHE ====================
        function debouncedFilter() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function() {
                loadPage(1);
            }, 400);
        }

        // ==================== CHARGEMENT AJAX ====================
        function loadPage(page) {
            currentPage = page;
            var loader = document.getElementById('loaderOverlay');
            loader.classList.add('active');

            var formData = new URLSearchParams();
            formData.append('page', page);
            formData.append('pageSize', document.getElementById('pageSize').value);
            formData.append('search', document.getElementById('searchGlobal').value);
            formData.append('famille', document.getElementById('filterFamille').value);
            formData.append('unite', document.getElementById('filterUnite').value);
            formData.append('stock', document.getElementById('filterStock').value);
            formData.append('sortBy', currentSort.by);
            formData.append('sortDir', currentSort.dir);

            fetch('@Url.Action("GetArticlesPage", "Stock")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        currentData = data.data;
                        renderTable(data.data);
                        renderPagination(data.pagination);
                        renderTotals(data.totals);
                        updateShowingInfo(data.pagination);
                        updateSelectAllCheckbox();
                    }
                    loader.classList.remove('active');
                })
                .catch(err => {
                    console.error(err);
                    loader.classList.remove('active');
                });
        }

        // ==================== RENDU TABLE ====================
        // function renderTable(data) {
        //     var tbody = document.getElementById('tableBody');
        //     var html = '';
        //     data.forEach(function(a) {
        //         var isSel = selectedIds.has(a.rowIndex);
        //         var qteClass = a.qte > 0 ? 'qty-positive' : 'qty-zero';
        //         html += '<tr class="' + (isSel ? 'selected' : '') + '" data-id="' + a.rowIndex + '">' +
        //             '<td><input type="checkbox" class="row-checkbox row-select" data-id="' + a.rowIndex + '" data-qte="' + a.qte + '" data-montant="' + a.montant + '" data-valeurini="' + a.valeurIni + '"' + (isSel ? ' checked' : '') + ' onchange="toggleRow(this)"></td>' +
        //             '<td>' + a.rowIndex + '</td>' +
        //             '<td class="ref-cell">' + escapeHtml(a.reference) + '</td>' +
        //             '<td class="intitule-cell" title="' + escapeHtml(a.intitule) + '">' + escapeHtml(a.intitule) + '</td>' +
        //             '<td class="intitule-cell" title="' + escapeHtml(a.intitule2) + '">' + escapeHtml(a.intitule2) + '</td>' +
        //             '<td class="intitule-cell" title="' + escapeHtml(a.intitule3) + '">' + escapeHtml(a.intitule3) + '</td>' +
        //             '<td>' + (a.famille ? '<span class="famille-badge">' + escapeHtml(a.famille) + '</span>' : '') + '</td>' +
