        function renderTable(data) {
    var tbody = document.getElementById('tableBody');
    var html = '';
    data.forEach(function (a) {
        var isSel = selectedIds.has(a.rowIndex);
        var qteClass = a.qte > 0 ? 'qty-positive' : 'qty-zero';
        html += '<tr class="' + (isSel ? 'selected' : '') + '" data-id="' + a.rowIndex + '">' +
            '<td><input type="checkbox" class="row-checkbox row-select" data-id="' + a.rowIndex + '" data-qte="' + a.qte + '" data-montant="' + a.montant + '" data-valeurini="' + a.valeurIni + '"' + (isSel ? ' checked' : '') + ' onchange="toggleRow(this)"></td>' +
            '<td>' + a.rowIndex + '</td>' +
            '<td class="ref-cell">' + escapeHtml(a.reference) + '</td>' +
            '<td class="intitule-cell" title="' + escapeHtml(a.intitule) + '">' + escapeHtml(a.intitule) + '</td>' +
            '<td class="intitule-cell" title="' + escapeHtml(a.intitule2) + '">' + escapeHtml(a.intitule2) + '</td>' +
            '<td class="intitule-cell" title="' + escapeHtml(a.intitule3) + '">' + escapeHtml(a.intitule3) + '</td>' +
            '<td>' + (a.famille ? '<span class="famille-badge">' + escapeHtml(a.famille) + '</span>' : '') + '</td>' +
            '<td class="qty-cell ' + qteClass + '">' + a.qteFmt + '</td>' +
            '<td>' + (a.unite ? '<span class="unite-badge">' + escapeHtml(a.unite) + '</span>' : '') + '</td>' +
            '<td class="money-cell">' + a.pampFmt + '</td>' +
            '<td class="money-cell highlight">' + a.montantFmt + '</td>' +
            '<td class="qty-cell">' + a.stockIniFmt + '</td>' +
            '<td class="money-cell">' + a.valeurIniFmt + '</td>' +
            '<td>' + escapeHtml(a.casier) + '</td>' +
            '<td class="date-cell">' + a.dateMaj + '</td>' +
            '<td style="text-align:center;">' +
                '<button class="btn-details" onclick="showArticleDetails(' + a.rowIndex + ')" title="Voir détails">' +
                    '<i class="fas fa-chart-line"></i>' +
                '</button>' +
            '</td>' +
            '</tr>';
    });
    tbody.innerHTML = html;
}

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/[&<>"']/g, function(m) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
            });
        }

        // ==================== TOTAUX ====================
        function renderTotals(t) {
            document.getElementById('totalQte').textContent = t.qte;
            document.getElementById('totalMontant').textContent = t.montant;
            document.getElementById('totalStockIni').textContent = t.stockIni;
            document.getElementById('totalValeurIni').textContent = t.valeurIni;
        }

        // ==================== PAGINATION ====================
        function renderPagination(p) {
            var container = document.getElementById('pageButtons');
            var html = '';

            html += '<button class="page-btn" onclick="loadPage(1)"' + (p.currentPage === 1 ? ' disabled' : '') + '><i class="fas fa-angles-left"></i></button>';
            html += '<button class="page-btn" onclick="loadPage(' + (p.currentPage - 1) + ')"' + (p.currentPage === 1 ? ' disabled' : '') + '><i class="fas fa-angle-left"></i></button>';

            var start = Math.max(1, p.currentPage - 2);
            var end = Math.min(p.totalPages, p.currentPage + 2);

            if (start > 1) html += '<span style="color:#94a3b8;">...</span>';
            for (var i = start; i <= end; i++) {
                html += '<button class="page-btn ' + (i === p.currentPage ? 'active' : '') + '" onclick="loadPage(' + i + ')">' + i + '</button>';
            }
            if (end < p.totalPages) html += '<span style="color:#94a3b8;">...</span>';

            html += '<button class="page-btn" onclick="loadPage(' + (p.currentPage + 1) + ')"' + (p.currentPage >= p.totalPages ? ' disabled' : '') + '><i class="fas fa-angle-right"></i></button>';
            html += '<button class="page-btn" onclick="loadPage(' + p.totalPages + ')"' + (p.currentPage >= p.totalPages ? ' disabled' : '') + '><i class="fas fa-angles-right"></i></button>';

            container.innerHTML = html;

            document.getElementById('paginationInfo').innerHTML =
                'Page <strong>' + p.currentPage + '</strong> sur <strong>' + p.totalPages + '</strong>';
        }

        function updateShowingInfo(p) {
            document.getElementById('showingInfo').innerHTML =
                'Affichage de <strong>' + p.showingFrom + '</strong> à <strong>' + p.showingTo + '</strong> sur <strong>' + p.totalRecords + '</strong> articles';
        }

        // ==================== FILTRES ====================
        function clearFilters() {
            document.getElementById('searchGlobal').value = '';
            document.getElementById('filterFamille').value = '';
            document.getElementById('filterUnite').value = '';
            document.getElementById('filterStock').value = '';
            loadPage(1);
        }

        // ==================== TRI ====================
        document.querySelectorAll('.articles-table thead th[data-sort]').forEach(function(th) {
            th.addEventListener('click', function() {
                var sortKey = this.getAttribute('data-sort');
                if (currentSort.by === sortKey) {
                    currentSort.dir = currentSort.dir === 'asc' ? 'desc' : 'asc';
                } else {
                    currentSort.by = sortKey;
                    currentSort.dir = 'asc';
                }
                document.querySelectorAll('.articles-table thead th').forEach(function(h) {
                    h.classList.remove('sorted-asc', 'sorted-desc');
                });
                this.classList.add('sorted-' + currentSort.dir);
                loadPage(1);
            });
        });

        // ==================== SÉLECTION ====================
        function toggleRow(cb) {
            var id = parseInt(cb.getAttribute('data-id'));
            var row = cb.closest('tr');
            if (cb.checked) {
                selectedIds.add(id);
                row.classList.add('selected');
            } else {
                selectedIds.delete(id);
                row.classList.remove('selected');
            }
            updateSelection();
        }

        function toggleSelectAll() {
            var checked = document.getElementById('selectAll').checked;
            document.querySelectorAll('.row-select').forEach(function(cb) {
                cb.checked = checked;
                var id = parseInt(cb.getAttribute('data-id'));
                if (checked) selectedIds.add(id);
                else selectedIds.delete(id);
                cb.closest('tr').classList.toggle('selected', checked);
            });
            updateSelection();
        }

        function updateSelectAllCheckbox() {
            var allChecks = document.querySelectorAll('.row-select');
            var allChecked = allChecks.length > 0 && Array.from(allChecks).every(c => c.checked);
            document.getElementById('selectAll').checked = allChecked;
        }

        function updateSelection() {
            var bar = document.getElementById('selectionBar');
            var total = selectedIds.size;

            if (total > 0) {
                // Calculer les totaux depuis les checkboxes actuellement visibles + garder trace
                var sumQte = 0, sumMontant = 0, sumValeurIni = 0;

                // Chercher dans currentData toutes les données sélectionnées
                currentData.forEach(function(a) {
                    if (selectedIds.has(a.rowIndex)) {
                        sumQte += parseFloat(a.qte) || 0;
                        sumMontant += parseFloat(a.montant) || 0;
                        sumValeurIni += parseFloat(a.valeurIni) || 0;
                    }
                });

                document.getElementById('selCount').textContent = total;
                document.getElementById('selQte').textContent = sumQte.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                document.getElementById('selMontant').textContent = sumMontant.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                document.getElementById('selValeurIni').textContent = sumValeurIni.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                bar.classList.add('active');
            } else {
                bar.classList.remove('active');
            }
        }

        function clearSelection() {
            selectedIds.clear();
            document.querySelectorAll('.row-select').forEach(function(c) {
                c.checked = false;
                c.closest('tr').classList.remove('selected');
            });
            document.getElementById('selectAll').checked = false;
            updateSelection();
        }

        // ==================== EXPORT ====================
        function exportExcel() {
            var params = new URLSearchParams();
            params.append('search', document.getElementById('searchGlobal').value);
            params.append('famille', document.getElementById('filterFamille').value);
            params.append('unite', document.getElementById('filterUnite').value);
            params.append('stock', document.getElementById('filterStock').value);
            window.location.href = '@Url.Action("ExportExcel", "Stock")?' + params.toString();
        }

        // ==================== INIT ====================
        document.addEventListener('DOMContentLoaded', function() {
            loadPage(1);
        });

        // ==================== MODAL DÉTAILS ====================
function showArticleDetails(rowIndex) {
    var loader = document.getElementById('loaderOverlay');
    loader.classList.add('active');

    fetch('@Url.Action("GetArticleDetails", "Stock")?rowIndex=' + rowIndex)
        .then(r => r.json())
        .then(data => {
            loader.classList.remove('active');
            if (!data.success) {
                alert('Erreur: ' + (data.message || 'Impossible de charger les détails'));
                return;
            }
            fillArticleDetails(data.article);
            document.getElementById('detailsModal').classList.add('active');
            switchTab('identification');
        })
        .catch(err => {
            loader.classList.remove('active');
            console.error(err);
            alert('Erreur de chargement');
        });
}

function fillArticleDetails(a) {
    // Header
    document.getElementById('mdRef').textContent = a.reference || '—';

    // Tab 1: Identification
    setValue('mdIdRef', a.reference);
    setValue('mdIdIntitule', a.intitule);
    setValue('mdIdIntitule2', a.intitule2);
    setValue('mdIdIntitule3', a.intitule3);
    setValue('mdIdFamille', a.famille);
    setValue('mdIdLieu', a.lieuStockage);
    setValue('mdIdCasier', a.casier);

    // Tab 2: Stock & Prix
    setValue('mdStkQte', a.qte);
    setValue('mdStkPamp', a.pamp);
    setValue('mdStkPrixAchat', a.prixAchat);
    setValue('mdStkValeurIni', a.valeurIni);
    setValue('mdStkStockIni', a.stockIni);
    setValue('mdStkMax', a.stockMax);
    setValue('mdStkSecurite', a.stockSecurite);
    setValue('mdStkDateMaj', a.dateMaj);

    // Tab 3: Statistiques
    setValue('mdStTotEnt', a.totalMvtEntrees);
    setValue('mdStTotSor', a.totalMvtSorties);
    setValue('mdStQteEnt', a.qteEntrees);
    setValue('mdStQteSor', a.qteSorties);
    setValue('mdStValResiduelle', a.valeurResiduelle);
    setValue('mdStAchat', a.achatHT);
    setValue('mdStConso', a.consoHT);
    setValue('mdStCession', a.cessionHT);
    setValue('mdStReinte', a.reinteHT);
}

function setValue(id, val) {
    var el = document.getElementById(id);
    if (!el) return;

    if (val === null || val === undefined || val === '' || val === '0' || val === '0.00') {
        // Pour Valeur Résiduelle et champs monétaires, afficher 0,00
        if (id === 'mdStValResiduelle' || id === 'mdStAchat' || id === 'mdStConso' ||
            id === 'mdStCession' || id === 'mdStReinte' || id === 'mdStkPrixAchat' ||
            id === 'mdStkValeurIni' || id === 'mdStkStockIni' || id === 'mdStkMax' ||
            id === 'mdStkSecurite') {
            el.textContent = val || '0,00';
            el.classList.remove('empty');
        }
        else if (id === 'mdStkQte' || id === 'mdStkPamp' || id === 'mdStTotEnt' ||
                 id === 'mdStTotSor' || id === 'mdStQteEnt' || id === 'mdStQteSor') {
            el.textContent = val || '0';
            el.classList.remove('empty');
        }
        else {
            el.textContent = '—';
            el.classList.add('empty');
        }
    } else {
        el.textContent = val;
        el.classList.remove('empty');
    }
}

function switchTab(tabName) {
    // Boutons
    document.querySelectorAll('.md-tab').forEach(function (t) {
        t.classList.toggle('active', t.getAttribute('data-tab') === tabName);
    });
    // Contenus
    document.querySelectorAll('.md-tab-content').forEach(function (c) {
        c.classList.toggle('active', c.id === 'tab-' + tabName);
    });
}

function closeDetailsModal() {
    document.getElementById('detailsModal').classList.remove('active');
}

function closeDetailsIfOverlay(event) {
    if (event.target === event.currentTarget) closeDetailsModal();
}

// Escape key pour fermer
document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
        var modal = document.getElementById('detailsModal');
        if (modal && modal.classList.contains('active')) closeDetailsModal();
    }
});
    </script>
