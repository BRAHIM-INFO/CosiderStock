/* Valeur Résiduelle Big Card */
.md-value-residuelle {
    background: linear-gradient(135deg, #3498db, #2980b9);
    color: #fff;
    padding: 18px 22px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 8px 20px rgba(52,152,219,0.25);
