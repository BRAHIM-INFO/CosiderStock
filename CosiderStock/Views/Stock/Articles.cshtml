@model CosiderStock.Models.ArticlesViewModel
@{
    ViewBag.Title = "Liste des Articles";
    Layout = "_DashboardLayout";
}

@section styles {
    <style>
        /* Élargir le main-content pour cette page */
        .main-content {
            padding: 15px !important;
        }

        /* ==================== HEADER COMPACT ==================== */
      .page-header-compact {
    background: linear-gradient(135deg, #C8102E, #e63950);
    border-radius: 14px;
    padding: 14px 22px;
    color: #fff;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    box-shadow: 0 6px 20px rgba(200, 16, 46, 0.25);
    position: relative;
    overflow: hidden;
}
.page-header-compact::before {
    content: '';
    position: absolute;
    width: 250px;
    height: 250px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    top: -100px;
    right: -50px;
}
.ph-left, .ph-actions { position: relative; z-index: 1; }

        .ph-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

    .ph-icon {
    width: 42px; height: 42px;
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    font-size: 17px;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 15px rgba(255, 255, 255, 0.1);
}

        .ph-info h1 {
            font-size: 17px;
            font-weight: 700;
            margin: 0;
        }

        .ph-info p {
            font-size: 11px;
            opacity: 0.7;
            margin: 2px 0 0;
        }

        .ph-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        /* ==================== STATS COMPACTES ==================== */
        .stock-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 10px;
            margin-bottom: 12px;
        }

        .stock-stat {
            background: #fff;
            border-radius: 11px;
            padding: 12px 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            border: 1px solid #f1f5f9;
            transition: all 0.2s;
        }

            .stock-stat:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(0,0,0,0.05);
            }

        .ss-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

            .ss-icon.red {
                background: rgba(200,16,46,0.1);
                color: #C8102E;
            }

            .ss-icon.blue {
                background: rgba(52,152,219,0.1);
                color: #3498db;
            }

            .ss-icon.green {
                background: rgba(46,204,113,0.1);
                color: #2ecc71;
            }

            .ss-icon.orange {
                background: rgba(230,126,34,0.1);
                color: #e67e22;
            }

        .ss-info .value {
            font-size: 17px;
            font-weight: 800;
            color: #1a1a2e;
            line-height: 1;
        }

        .ss-info .label {
            font-size: 10px;
            color: #94a3b8;
            margin-top: 2px;
        }

        /* ==================== SELECTION BAR ==================== */
        .selection-bar {
            display: none;
            background: linear-gradient(135deg, #2ecc71, #27ae60);
            border-radius: 11px;
            padding: 12px 20px;
            margin-bottom: 12px;
            color: #fff;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            animation: slideDown 0.3s ease;
        }

            .selection-bar.active {
                display: flex;
            }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .sel-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .sel-info i {
                font-size: 18px;
            }

        .sel-count {
            font-size: 17px;
            font-weight: 800;
        }

        .sel-label {
            font-size: 11px;
            opacity: 0.9;
        }

        .sel-stats {
            display: flex;
            gap: 22px;
            flex-wrap: wrap;
        }

        .sel-stat-item .val {
            font-size: 15px;
            font-weight: 700;
        }

        .sel-stat-item .lbl {
            font-size: 9px;
            opacity: 0.85;
            text-transform: uppercase;
        }

        .btn-clear-sel {
            background: rgba(255,255,255,0.2);
            border: none;
            color: #fff;
            padding: 6px 14px;
            border-radius: 7px;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            font-size: 11px;
            font-weight: 600;
        }

            .btn-clear-sel:hover {
                background: rgba(255,255,255,0.35);
            }

        /* ==================== FILTERS COMPACTS ==================== */
        .filters-section {
            background: #fff;
            border-radius: 11px;
            padding: 12px 18px;
            margin-bottom: 12px;
            border: 1px solid #f1f5f9;
        }

        .filters-row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr auto auto;
            gap: 10px;
            align-items: center;
        }

        .filter-group label {
            display: block;
            font-size: 10px;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 4px;
            letter-spacing: 0.3px;
        }

        .filter-input {
            width: 100%;
            padding: 8px 12px;
            border: 2px solid #e8ecef;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
            background: #fafbfc;
            transition: all 0.2s;
        }

            .filter-input:focus {
                outline: none;
                border-color: #C8102E;
                background: #fff;
            }

        select.filter-input {
            cursor: pointer;
        }

        .btn-clear-filters, .btn-refresh {
            padding: 8px 14px;
            border: 1px solid #e8e8e8;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            font-size: 11px;
            font-weight: 600;
            background: #f5f6fa;
            color: #666;
            transition: all 0.2s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            height: 36px;
            align-self: end;
        }

            .btn-clear-filters:hover {
                background: #e8e8e8;
            }

    .btn-refresh {
    background: #C8102E;
    color: #fff;
    border-color: #C8102E;
}
.btn-refresh:hover { background: #a80d26; }

        /* ==================== TABLE - PRIORITÉ MAX ==================== */
        .table-container {
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #f1f5f9;
            box-shadow: 0 2px 12px rgba(0,0,0,0.03);
        }

        .table-info-bar {
            padding: 10px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #f1f5f9;
            background: #fafbfc;
            flex-wrap: wrap;
            gap: 10px;
        }

            .table-info-bar .showing {
                font-size: 12px;
                color: #64748b;
            }

                .table-info-bar .showing strong {
                    color: #C8102E;
                    font-weight: 700;
                }

        /* Table hauteur adaptative */
        .table-wrapper {
            overflow-x: auto;
            overflow-y: auto;
            max-height: calc(100vh - 340px);
            min-height: 400px;
        }

        .articles-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1400px;
            font-size: 12px;
        }

            .articles-table thead {
                position: sticky;
                top: 0;
                z-index: 10;
            }

             .articles-table thead th {
    background: linear-gradient(135deg, #C8102E, #e63950);
    color: #fff;
    padding: 11px 10px;
    text-align: left;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    border-bottom: 3px solid #8b0a1f;
}
.articles-table thead th:hover {
    background: linear-gradient(135deg, #a80d26, #C8102E);
}
.articles-table thead th.sorted-asc::after,
.articles-table thead th.sorted-desc::after {
    color: #ffd93d !important;
}
.articles-table thead th.sorted-asc::after,
.articles-table thead th.sorted-desc::after {
    color: #fff !important;
}

                    .articles-table thead th:hover {
                        background: linear-gradient(135deg, #16213e, #0f3460);
                    }

                    .articles-table thead th.sorted-asc::after {
                        content: ' ▲';
                        font-size: 9px;
                        color: #C8102E;
                    }

                    .articles-table thead th.sorted-desc::after {
                        content: ' ▼';
                        font-size: 9px;
                        color: #C8102E;
                    }

                    .articles-table thead th:first-child {
                        width: 40px;
                        text-align: center;
                        cursor: default;
                    }

                    .articles-table thead th:nth-child(2) {
                        width: 45px;
                        text-align: center;
                    }

            .articles-table tbody tr {
                border-bottom: 1px solid #f5f7fa;
                transition: background 0.15s;
            }

                .articles-table tbody tr:hover {
                    background: rgba(200,16,46,0.03);
                }

                .articles-table tbody tr.selected {
                    background: rgba(46,204,113,0.08) !important;
                }

                .articles-table tbody tr:nth-child(even) {
                    background: #fafbfc;
                }

                    .articles-table tbody tr:nth-child(even).selected {
                        background: rgba(46,204,113,0.08) !important;
                    }

            .articles-table tbody td {
                padding: 9px 10px;
                color: #333;
                vertical-align: middle;
            }

                .articles-table tbody td:first-child {
                    text-align: center;
                }

                .articles-table tbody td:nth-child(2) {
                    text-align: center;
                    font-size: 10px;
                    color: #94a3b8;
                }

        .row-checkbox {
            width: 16px;
            height: 16px;
            accent-color: #C8102E;
            cursor: pointer;
        }

 .ref-cell {
    font-weight: 700;
    color: #C8102E;
    font-size: 12px;
    white-space: nowrap;
}

        .intitule-cell {
            max-width: 180px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .famille-badge {
            display: inline-block;
            padding: 2px 8px;
            background: rgba(52,152,219,0.1);
            color: #3498db;
            border-radius: 10px;
            font-size: 10px;
            font-weight: 600;
        }

        .unite-badge {
            display: inline-block;
            padding: 2px 7px;
            background: #f1f5f9;
            color: #64748b;
            border-radius: 7px;
            font-size: 10px;
            font-weight: 600;
        }

        .money-cell {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            color: #1a1a2e;
            text-align: right;
            white-space: nowrap;
        }

            .money-cell.highlight { color: #C8102E; }


        .qty-cell {
            font-weight: 700;
            text-align: center;
        }

        .qty-zero {
            color: #e74c3c;
        }

        .qty-positive {
            color: #27ae60;
        }

        .date-cell {
            font-size: 11px;
            color: #64748b;
            white-space: nowrap;
        }

        /* Totaux ligne */
      .total-row {
    background: linear-gradient(135deg, #C8102E, #e63950) !important;
    color: #fff !important;
}
.total-row td {
    padding: 12px 10px !important;
    color: #fff !important;
    font-weight: 800 !important;
    font-size: 13px !important;
    border-top: 3px solid #8b0a1f !important;
}

        /* ==================== PAGINATION ==================== */
        .pagination-bar {
            padding: 12px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid #f1f5f9;
            background: #fafbfc;
            flex-wrap: wrap;
            gap: 10px;
        }

        .pagination-info {
            font-size: 12px;
            color: #64748b;
        }

        .pagination-controls {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .page-size-select {
            padding: 6px 10px;
            border: 1px solid #e8ecef;
            border-radius: 7px;
            font-size: 11px;
            background: #fff;
            cursor: pointer;
        }

        .page-btn {
            min-width: 32px;
            height: 32px;
            padding: 0 8px;
            border: 1px solid #e8ecef;
            background: #fff;
            border-radius: 7px;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            font-size: 11px;
            font-weight: 600;
            color: #64748b;
            transition: all 0.2s;
        }

            .page-btn:hover:not(:disabled) {
                background: #C8102E;
                color: #fff;
                border-color: #C8102E;
            }

            .page-btn.active {
                background: linear-gradient(135deg, #C8102E, #e63950);
                color: #fff;
                border-color: #C8102E;
            }

            .page-btn:disabled {
                opacity: 0.4;
                cursor: not-allowed;
            }

        /* ==================== BUTTONS ==================== */
        .btn-action {
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 11px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            text-decoration: none;
        }

        .btn-red {
            background: linear-gradient(135deg, #C8102E, #e63950);
            color: #fff;
        }

            .btn-red:hover {
                transform: translateY(-2px);
            }

        .btn-green {
            background: linear-gradient(135deg, #2ecc71, #27ae60);
            color: #fff;
        }

            .btn-green:hover {
                transform: translateY(-2px);
            }

        .btn-outline {
            background: transparent;
            color: #fff;
            border: 1px solid rgba(255,255,255,0.3);
        }

            .btn-outline:hover {
                background: rgba(255,255,255,0.1);
            }

        /* ==================== LOADER ==================== */
        .loader-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255,255,255,0.85);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 100;
            backdrop-filter: blur(2px);
        }

            .loader-overlay.active {
                display: flex;
            }

        .loader-spinner {
            width: 40px;
            height: 40px;
            border: 4px solid #f0f0f0;
            border-top: 4px solid #C8102E;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ==================== ERROR STATE ==================== */
        .error-state {
            background: #fff5f5;
            border: 2px solid #fecaca;
            border-radius: 14px;
            padding: 30px;
            text-align: center;
        }

            .error-state i {
                font-size: 50px;
                color: #e74c3c;
                margin-bottom: 15px;
            }

            .error-state h3 {
                font-size: 18px;
                color: #c0392b;
                margin-bottom: 8px;
            }

            .error-state p {
                font-size: 13px;
                color: #e74c3c;
            }

        @@media (max-width: 992px) {
            .filters-row {
                grid-template-columns: 1fr 1fr;
            }

            .stock-stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* ==================== ZR DÉTAILS ==================== */
.btn-details {
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 8px;
    background: linear-gradient(135deg, #3498db, #2980b9);
    color: #fff;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    transition: all 0.2s;
    box-shadow: 0 3px 10px rgba(52,152,219,0.25);
}
.btn-details:hover {
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 5px 15px rgba(52,152,219,0.4);
}

/* ==================== MODAL DÉTAILS ==================== */
.modal-details-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.6);
    z-index: 9998;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
    padding: 20px;
}
.modal-details-overlay.active {
    display: flex;
    animation: fadeIn 0.3s;
}
@@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.modal-details {
    background: #fff;
    border-radius: 16px;
    width: 100%;
    max-width: 900px;
    max-height: 90vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: modalSlideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 25px 60px rgba(0,0,0,0.3);
}
@@keyframes modalSlideIn {
    from { transform: translateY(-30px) scale(0.95); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
}

.modal-details-header {
    background: linear-gradient(135deg, #3498db, #2980b9);
    color: #fff;
    padding: 18px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.mdh-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    font-weight: 700;
}
.mdh-title i {
    font-size: 18px;
}
.mdh-ref-badge {
    background: rgba(255,255,255,0.9);
    color: #1a1a2e;
    padding: 5px 15px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    font-family: 'Courier New', monospace;
    margin-left: 10px;
}
.modal-details-close {
    background: rgba(255,255,255,0.15);
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 14px;
}
.modal-details-close:hover {
    background: rgba(255,255,255,0.3);
    transform: rotate(90deg);
}

/* Tabs */
.modal-details-tabs {
    display: flex;
    gap: 10px;
    padding: 20px 25px 0;
    background: #f8fafc;
    border-bottom: 1px solid #e8ecef;
    justify-content: center;
}
.md-tab {
    padding: 10px 22px;
    background: #fff;
    border: 2px solid #e8ecef;
    border-radius: 25px;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
}
.md-tab:hover {
    border-color: #3498db;
    color: #3498db;
}
.md-tab.active {
    background: linear-gradient(135deg, #3498db, #2980b9);
    color: #fff;
    border-color: #3498db;
    box-shadow: 0 5px 15px rgba(52,152,219,0.3);
}

/* Body */
.modal-details-body {
    padding: 25px 30px;
    overflow-y: auto;
    flex: 1;
    background: #fafbfc;
}

.md-tab-content { display: none; }
.md-tab-content.active {
    display: block;
    animation: fadeInUp 0.3s;
}
@@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Form Grid */
.md-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 15px;
}
.md-form-row.three { grid-template-columns: 1fr 1fr 1fr; }
.md-form-row.four { grid-template-columns: 1fr 1fr 1fr 1fr; }

.md-field {
    background: #fff;
    padding: 12px 15px;
    border-radius: 10px;
    border: 2px solid #e8ecef;
    transition: all 0.2s;
}
.md-field.readonly { background: #f5f6fa; }
.md-field label {
    display: block;
    font-size: 11px;
    color: #64748b;
    font-weight: 600;
    margin-bottom: 5px;
    letter-spacing: 0.3px;
}
.md-field .value {
    font-size: 14px;
    color: #1a1a2e;
    font-weight: 600;
    word-break: break-word;
}
.md-field .value.money {
    font-family: 'Courier New', monospace;
    color: #1a1a2e;
    font-weight: 700;
    font-size: 15px;
}
.md-field .value.empty {
    color: #cbd5e1;
    font-style: italic;
    font-weight: 400;
}

/* Highlighted Cards (Stock & Prix) */
.md-highlight {
    background: #fff;
    padding: 18px 20px;
    border-radius: 12px;
    border: 2px solid #e8ecef;
    border-left-width: 4px;
    transition: all 0.3s;
}
.md-highlight.green { border-left-color: #2ecc71; }
.md-highlight.blue { border-left-color: #3498db; }
.md-highlight.red { border-left-color: #C8102E; }
.md-highlight.orange { border-left-color: #f39c12; }

.md-highlight label {
    display: block;
    font-size: 11px;
    color: #64748b;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
    text-transform: uppercase;
}
.md-highlight.green label { color: #27ae60; }
.md-highlight.blue label { color: #2980b9; }
.md-highlight.red label { color: #C8102E; }
.md-highlight.orange label { color: #d68910; }

.md-highlight .big-value {
    font-size: 22px;
    font-weight: 800;
    color: #1a1a2e;
    line-height: 1;
    font-family: 'Courier New', monospace;
}

/* Stats Section */
.md-stats-section {
    background: #fff;
    border-radius: 12px;
    padding: 15px;
    border: 2px solid #e8ecef;
    margin-bottom: 15px;
}
